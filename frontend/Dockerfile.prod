# ==============================================================================
# Stage 1: Build the React + Vite Production Bundle
# ==============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies with clean lockfile caching
COPY package*.json ./
RUN npm ci || npm install

# Copy source code and build static production assets
COPY . .
ARG VITE_API_URL=/
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ==============================================================================
# Stage 2: Serve via Hardened Nginx Reverse Proxy
# ==============================================================================
FROM nginx:1.27-alpine AS runner

# Remove default nginx config and install Verixa production config
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/verixa.conf

# Copy compiled static bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]

