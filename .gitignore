# ==============================================================================
# Verixa Global .gitignore (Multi-Service Architecture)
# ==============================================================================

# OS & Systems
.DS_Store
Thumbs.db
*.bak
*.swp
*~
desktop.ini

# IDEs & Editor configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & Secrets (Crucial for Startups)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# ==============================================================================
# Frontend (React / Vite / Tailwind / Node)
# ==============================================================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/.eslintcache
frontend/.parcel-cache
frontend/.stylelintcache
frontend/coverage/

# ==============================================================================
# Backend (Python / Django / DRF / Celery)
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django database & media
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/
backend/static/
backend/staticfiles/

# Python virtual environments
.venv/
venv/
ENV/
env/
backend/venv/
backend/.venv/

# Celery & logs
celerybeat-schedule
celerybeat.pid
*.log
backend/logs/

# Django local settings override
backend/verixa_core/settings/local_settings.py

# ==============================================================================
# Machine Learning (ML) & Data
# ==============================================================================
# Serialized ML Models (weights are too large for git, track via DVC or Cloud Storage)
ml/models/*
!ml/models/.gitkeep
ml/config/*.local.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Datasets (large files should be pulled from S3/GCS or DVC, not git)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
datasets/external/*
!datasets/external/.gitkeep

# ==============================================================================
# Scrapers & Crawlers
# ==============================================================================
scrapers/logs/
scrapers/geckodriver.log
scrapers/ghostdriver.log
scrapers/chromedriver.log
scrapers/dump/
scrapers/.scrapy/
scrapers/spiders/__pycache__/
scrapers/pipelines/__pycache__/
scrapers/utils/__pycache__/

# ==============================================================================
# Testing
# ==============================================================================
tests/reports/
tests/e2e/screenshots/
tests/e2e/videos/
.nyc_output/
coverage/
htmlcov/
