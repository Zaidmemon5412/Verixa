# ==============================================================================
# Verixa Global Environment Variables Template (.env.example)
# Duplicate this file to '.env' and populate actual values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service (Django / DRF)
# ------------------------------------------------------------------------------
# Use 'verixa_core.settings.local' for development or 'verixa_core.settings.production' for deployment
DJANGO_SETTINGS_MODULE=verixa_core.settings.local
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-real-50-char-secret-key-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# API Rate Limiting & Abuse Prevention (DRF Throttling)
# ------------------------------------------------------------------------------
THROTTLE_RATE_ANON=120/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_AUTH=5/min
THROTTLE_RATE_PASSWORD_RESET=5/hour
THROTTLE_RATE_AI_ADVISOR=15/min
THROTTLE_RATE_WRITE_ACTION=20/min

# ------------------------------------------------------------------------------
# Database Config (PostgreSQL)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=verixa_db
DB_USER=verixa_user
DB_PASSWORD=verixa_secure_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery (For async background scraping & model inference)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# OCR Configuration (Tesseract)
# ------------------------------------------------------------------------------
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
TESSERACT_CMD_PATH=/usr/bin/tesseract

# ------------------------------------------------------------------------------
# Scrapers & Crawling Configurations
# ------------------------------------------------------------------------------
SCRAPER_USER_AGENT="VerixaPropertyBot/1.0 (+http://verixa.com/bot)"
SCRAPER_PROXY_URL=http://username:password@proxy.example.com:8080
SCRAPER_SELENIUM_HUB_URL=http://localhost:4444/wd/hub
SCRAPER_HEADLESS=True
SCRAPER_REQUEST_TIMEOUT=30

# ------------------------------------------------------------------------------
# Machine Learning (ML) Models
# ------------------------------------------------------------------------------
ML_MODEL_PATH=ml/models/property_valuation_v1.pkl
ML_FEATURE_CONFIG_PATH=ml/config/features.json
ML_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Service (Vite / React)
# ------------------------------------------------------------------------------
# Must prefix with VITE_ to be exposed to client-side code
VITE_API_URL=http://localhost:8000
VITE_MAP_DEFAULT_LAT=40.7128
VITE_MAP_DEFAULT_LNG=-74.0060
VITE_MAP_DEFAULT_ZOOM=13

# ------------------------------------------------------------------------------
# Cloud Storage (Cloudinary) & AI Advisor (Google Gemini)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
GEMINI_API_KEY=your_google_gemini_api_key

# ------------------------------------------------------------------------------
# Email / SMTP Configuration
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_smtp_app_password
DEFAULT_FROM_EMAIL="Verixa Support <noreply@verixa.com>"
FRONTEND_URL=http://localhost:5173

