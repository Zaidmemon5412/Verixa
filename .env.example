# ==============================================================================
# Verixa Global Environment Variables Template (.env.example)
# Duplicate this file to '.env' and populate actual values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service (Django / DRF)
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-for-production-1234
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database Config (PostgreSQL)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=verixa_db
DB_USER=verixa_user
DB_PASSWORD=verixa_secure_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery (For async background scraping & model inference)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# OCR Configuration (Tesseract)
# ------------------------------------------------------------------------------
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
TESSERACT_CMD_PATH=/usr/bin/tesseract

# ------------------------------------------------------------------------------
# Scrapers & Crawling Configurations
# ------------------------------------------------------------------------------
SCRAPER_USER_AGENT="VerixaPropertyBot/1.0 (+http://verixa.com/bot)"
SCRAPER_PROXY_URL=http://username:password@proxy.example.com:8080
SCRAPER_SELENIUM_HUB_URL=http://localhost:4444/wd/hub
SCRAPER_HEADLESS=True
SCRAPER_REQUEST_TIMEOUT=30

# ------------------------------------------------------------------------------
# Machine Learning (ML) Models
# ------------------------------------------------------------------------------
ML_MODEL_PATH=ml/models/property_valuation_v1.pkl
ML_FEATURE_CONFIG_PATH=ml/config/features.json
ML_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Service (Vite / React)
# ------------------------------------------------------------------------------
# Must prefix with VITE_ to be exposed to client-side code
VITE_API_URL=http://localhost:8000
VITE_MAP_DEFAULT_LAT=40.7128
VITE_MAP_DEFAULT_LNG=-74.0060
VITE_MAP_DEFAULT_ZOOM=13

CLOUDINARY_CLOUD_NAME=g2buh1b3
CLOUDINARY_API_KEY=985876594477229
CLOUDINARY_API_SECRET=rid1-ZtK9PDKp_PNNwQ38bIJ1rU

