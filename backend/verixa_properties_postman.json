                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{access_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"property_name\": \"Luxury Villa Test\",\n    \"property_type\": \"villa\",\n    \"transaction_type\": \"new\",\n    \"price\": 15000000,\n    \"price_per_sqft\": 5000,\n    \"bhk\": 3,\n    \"carpet_area\": 3000,\n    \"latitude\": 19.0760,\n    \"longitude\": 72.8777,\n    \"status\": \"ready\",\n    \"address\": \"123 Mumbai Street\",\n    \"builder\": null,\n    \"locality\": null\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/properties/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "properties",
                        ""
                    ]
                }
            },
            "response": []
        },
        {
